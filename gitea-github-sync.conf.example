# Trusted Bash configuration. Save as /etc/gitea-github-sync.conf (chmod 600).
GITEA_TOKEN='REPLACE_WITH_GITEA_TOKEN'
# Optional for public GitHub repositories; recommended to increase rate limits.
GITHUB_TOKEN=''
# Required: replace this example with your own Gitea instance URL.
# Include a web path prefix if used, e.g. https://example.com/gitea.
# Do not append /api/v1. There is no built-in server address.
GITEA_URL='https://gitea.example.com'
# Leave empty to discover the account from GITEA_TOKEN, or specify an owner.
# All repositories owned by this account are scanned, including private ones
# visible to the token. Collaborator repositories owned by others are excluded.
GITEA_OWNER=''
# Source owners and repository names are derived from each mirror's original_url.
GITHUB_API='https://api.github.com'
GITHUB_API_VERSION='2026-03-10'
# Maximum total waiting time per GitHub request; longer limits stop the scan.
GITHUB_RATE_LIMIT_MAX_WAIT=60
GITHUB_RATE_LIMIT_RETRIES=2
LOCK_FILE='/var/run/gitea-github-sync.lock'
# Used only by --apply-quiet. Parent directory must already exist and be writable.
QUIET_LOG_FILE='/var/log/gitea-github-sync.log'

# Progress interval in seconds; slow requests may delay the next entry.
PROGRESS_INTERVAL=60
